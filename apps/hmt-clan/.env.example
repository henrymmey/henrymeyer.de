# ------------------------------------------------------------------
# HMT Clan – Website & Admin Dashboard
# ------------------------------------------------------------------
# Kopiere diese Datei nach `.env.local` und fülle die Werte aus.
# Secrets werden NIE ins Client-Bundle übernommen (keine NEXT_PUBLIC_*).

# SEO Configuration
NEXT_PUBLIC_URL=https://hmt-clan.example.com

# ------------------------------------------------------------------
# Admin Dashboard – Discord OAuth
# ------------------------------------------------------------------
# Anmeldung am /admin Dashboard ausschließlich über Discord.
# Discord Developer Application: https://discord.com/developers/applications
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://hmt-clan.example.com/api/admin/auth/callback

# Komma-separierte Discord User IDs (Snowflakes) der Admins.
# Nur diese Benutzer dürfen das /admin Dashboard verwenden.
DISCORD_ALLOWED_USER_IDS=

# ------------------------------------------------------------------
# Admin Dashboard – MeyerAuth (OIDC via Authentik)
# ------------------------------------------------------------------
# Anmeldung am /admin Dashboard über den eigenen Authentik-IdP.
# In Authentik: Flows & Ausführung > Provider > OAuth2/OpenID Provider
# erstellen, Scopes "email" + "profile" aktivieren, Redirect-URI wie oben.
# Redirect-URI bei Authentik (verbatim):
# https://hmt-clan.example.com/api/admin/auth/callback
MEYERAUTH_ISSUER=
MEYERAUTH_CLIENT_ID=
MEYERAUTH_CLIENT_SECRET=
MEYERAUTH_REDIRECT_URI=https://hmt-clan.example.com/api/admin/auth/callback

# Komma-separierte E-Mail-Adressen der Admins.
# Nur diese E-Mails dürfen das /admin Dashboard verwenden.
MEYERAUTH_ALLOWED_EMAILS=

# ------------------------------------------------------------------
# Admin Dashboard – Session
# ------------------------------------------------------------------
# Kryptografisch sicherer Wert zum Signieren der Session-Cookies.
# In Produktion generieren, z. B.: openssl rand -base64 32
AUTH_SECRET=

# ------------------------------------------------------------------
# Admin Dashboard – HMT Clan GitHub Bot
# ------------------------------------------------------------------
# Eigener GitHub Account NUR für den Bot (nicht dein persönlicher!).
# Token: GitHub > Settings > Developer settings > Personal access tokens
#        (fine-grained, nur das Ziel-Repository, Inhalt: Lesen + Schreiben)
# Der Token darf ausschließlich serverseitig verwendet werden.
HMT_GITHUB_TOKEN=
HMT_GITHUB_OWNER=henrymmey
HMT_GITHUB_REPOSITORY=henrymeyer.de
HMT_GITHUB_BRANCH=main